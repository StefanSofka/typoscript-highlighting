{
  "name": "typoscript-highlighting",
  "displayName": "TYPO3 - TypoScript Highlighting",
  "description": "Syntax highlighting for TypoScript files of TYPO3 in VS Code.",
  "version": "1.0.3",
  "publisher": "stefan-sofka",
  "author": {
    "name": "Stefan Sofka",
    "email": "stefan.sofka@mailbox.org"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/StefanSofka/typoscript-highlighting.git"
  },
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages",
    "Themes",
    "Other"
  ],
  "contributes": {
    "languages": [
      {
        "id": "typoscript",
        "aliases": [
          "TypoScript",
          "typoscript"
        ],
        "extensions": [
          ".typoscript",
          ".tsconfig"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "typoscript-v11",
        "aliases": [
          "TypoScript (v11)"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "typoscript-v12",
        "aliases": [
          "TypoScript (v12+)"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "typoscript",
        "scopeName": "source.typoscript",
        "path": "./syntaxes/typoscript.tmLanguage.json"
      },
      {
        "language": "typoscript-v11",
        "scopeName": "source.typoscript",
        "path": "./syntaxes/typoscript-v11.tmLanguage.json"
      },
      {
        "language": "typoscript-v12",
        "scopeName": "source.typoscript",
        "path": "./syntaxes/typoscript.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "TypoScript Highlighting",
      "properties": {
        "typoscriptHighlighting.commentRules": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "v11",
            "v12"
          ],
          "markdownDescription": "Select which TypoScript comment rules to use. `auto` detects the TYPO3 version from composer files."
        }
      }
    }
  },
  "activationEvents": [
    "onLanguage:typoscript",
    "onLanguage:typoscript-v11",
    "onLanguage:typoscript-v12"
  ],
  "main": "./extension.js",
  "scripts": {
    "vscode:prepublish": "echo \"No TypeScript compilation needed.\""
  },
  "dependencies": {
    "@vscode/vsce": "^3.2.1"
  }
}
